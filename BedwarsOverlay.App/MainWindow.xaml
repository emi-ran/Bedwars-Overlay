<Window x:Class="BedwarsOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BedwarsOverlay.App"
        mc:Ignorable="d"
        Title="Cubelify Overlay" Height="450" Width="800"
        MinWidth="400" MinHeight="200"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" 
                      CornerRadius="0" 
                      CaptionHeight="0" 
                      ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Minimize Button Style -->
        <Style x:Key="MinimizeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid x:Name="MainGrid">
        <Border x:Name="OverlayBorder" CornerRadius="8" BorderThickness="1.5" BorderBrush="#1F2937" Background="#0F0F11">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- Draggable Title Bar (styled like Cubelify) -->
                <Grid x:Name="TitleBar" Background="#0F0F11" MouseDown="TitleBar_MouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left: Hamburger & Gold Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="#FF94A3B8" FontSize="14" Margin="0,0,12,0" Cursor="Hand" VerticalAlignment="Center"/>
                        <TextBlock Text="Cubelify Overlay" Foreground="#EAB308" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Center: Action Icons & Search Box -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="#FF94A3B8" FontSize="14" Margin="0,0,18,0" Cursor="Hand" ToolTip="Clear &amp; Refresh" VerticalAlignment="Center" MouseDown="RefreshButton_Click"/>
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="#FF94A3B8" FontSize="14" Margin="0,0,18,0" Cursor="Hand" ToolTip="Players List" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#FF94A3B8" FontSize="14" Margin="0,0,20,0" Cursor="Hand" ToolTip="Settings" VerticalAlignment="Center" MouseDown="SettingsButton_Click"/>
                        
                        <!-- Search Box -->
                        <Border CornerRadius="6" Background="#18181A" BorderThickness="1.2" BorderBrush="#2D2D30" Height="28" Width="200" Padding="6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="&#xE93E;" FontFamily="Segoe MDL2 Assets" Foreground="#66FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                
                                <Grid Grid.Column="1">
                                    <TextBlock Text="Search player(s)" Foreground="#66FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0" 
                                               x:Name="SearchPlaceholder" IsHitTestVisible="False"/>
                                    <TextBox Background="Transparent" BorderThickness="0" Foreground="White" FontSize="11" VerticalAlignment="Center"
                                             CaretBrush="White"
                                             x:Name="SearchBox" GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" TextChanged="SearchBox_TextChanged"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                    
                    <!-- Right: Exit Window Button -->
                    <StackPanel Grid.Column="2" x:Name="ControlButtons" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Style="{StaticResource MinimizeButtonStyle}" Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Separator line under Header -->
                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1.2" Background="#1A1A1C"/>

                <!-- Main Area: DataGrid Table -->
                <Grid Grid.Row="1">
                    <!-- Placeholder Text (Shown when no logs/players) -->
                    <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="20">
                        <TextBlock x:Name="DemoText" Text="Bedwars Overlay Active" Foreground="White" FontSize="18" FontWeight="Bold" TextAlignment="Center" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="ParsedPlayersText" Text="Waiting for Minecraft logs... Type /who in-game." Foreground="#FFCCCCCC" FontSize="13" Margin="0,8,0,0" TextAlignment="Center" FontFamily="Segoe UI" TextWrapping="Wrap" MaxWidth="600"/>
                    </StackPanel>

                    <!-- Player Stats Grid -->
                    <DataGrid x:Name="PlayersGrid"
                               Background="Transparent"
                               BorderThickness="0"
                               AutoGenerateColumns="False"
                               CanUserAddRows="False"
                               CanUserDeleteRows="False"
                               CanUserReorderColumns="False"
                               CanUserResizeColumns="False"
                               CanUserSortColumns="True"
                               GridLinesVisibility="Horizontal"
                               HorizontalGridLinesBrush="#10FFFFFF"
                               VerticalGridLinesBrush="Transparent"
                               RowHeaderWidth="0"
                               SelectionMode="Single"
                               SelectionUnit="FullRow"
                               IsReadOnly="True"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                               ScrollViewer.VerticalScrollBarVisibility="Auto">
                        
                        <DataGrid.Resources>
                            <!-- Header Style -->
                            <Style x:Key="DefaultHeaderStyle" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FF94A3B8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                            </Style>
                            
                            <!-- Apply default style to all headers in this grid -->
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}"/>
                            
                            <!-- Cell Style -->
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#15FFFFFF"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding RowBackground}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#10FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        
                        <DataGrid.Columns>
                            <!-- Level Column -->
                            <DataGridTextColumn Header="Lvl" Binding="{Binding Level}" Width="45" IsReadOnly="True">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{Binding LevelColor}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Name Column -->
                            <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="15,8,10,8"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,0,0,0">
                                            <!-- Blue User Icon for Local Player -->
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#3B82F6" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" 
                                                       Visibility="{Binding LocalPlayerIconsVisibility}"/>
                                            <!-- Blue Shield Icon for Local Player -->
                                            <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" Foreground="#3B82F6" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" 
                                                       Visibility="{Binding LocalPlayerIconsVisibility}"/>
                                            
                                            <!-- Warning Symbol for High Risk / Blacklist -->
                                            <TextBlock Text="⚠" Foreground="#FFEF4444" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" 
                                                       Visibility="{Binding TagVisibility}"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding NameColor}" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Winstreak Column -->
                            <DataGridTextColumn Header="WS" Binding="{Binding Winstreak}" Width="45">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{Binding WinstreakColor}"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- FKDR Column -->
                            <DataGridTextColumn Header="FKDR" Binding="{Binding Fkdr}" Width="55">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{Binding FkdrColor}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- WLR Column -->
                            <DataGridTextColumn Header="WLR" Binding="{Binding Wlr}" Width="55">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{Binding WlrColor}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Final Kills Column -->
                            <DataGridTextColumn Header="F. Kills" Binding="{Binding FinalKills}" Width="65">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding FinalsColor}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Wins Column -->
                            <DataGridTextColumn Header="Wins" Binding="{Binding Wins}" Width="65">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding WinsColor}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Sniper Column -->
                            <DataGridTextColumn Header="Sniper" Binding="{Binding Sniper}" Width="65">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{Binding SniperColor}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Action Column (...) -->
                            <DataGridTemplateColumn Width="35">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="&#xE712;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="#66FFFFFF" BorderThickness="0" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Click="EllipsisButton_Click" Cursor="Hand">
                                            <Button.ContextMenu>
                                                <ContextMenu Background="#1E1E1E" Foreground="White" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                    <MenuItem Header="Copy Username" Click="CopyUsername_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Open Plancke Stats" Click="OpenPlancke_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator Background="#22FFFFFF"/>
                                                    <MenuItem Header="Add to Blacklist" Click="AddBlacklist_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE107;" FontFamily="Segoe MDL2 Assets" Foreground="Red" FontSize="12" VerticalAlignment="Center"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Remove from Blacklist" Click="RemoveBlacklist_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="&#xE10A;" FontFamily="Segoe MDL2 Assets" Foreground="Green" FontSize="12" VerticalAlignment="Center"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Diagnostics Panel (Visible in Edit Mode only) -->
                <Border x:Name="DiagnosticsPanel" Grid.Row="2" Margin="10" Padding="10" Background="#121214" CornerRadius="6" BorderThickness="1.2" BorderBrush="#1F2937" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="LOG DIAGNOSTICS (Last 20 Log Lines):" Foreground="#FF818CF8" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" FontFamily="Segoe UI"/>
                        <ListBox x:Name="LogDiagnosticsList" Grid.Row="1" Height="80" Background="Transparent" BorderThickness="0" Foreground="#FFAAAAAA" FontSize="10" FontFamily="Consolas, Courier New"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
