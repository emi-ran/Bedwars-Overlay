<Window x:Class="BedwarsOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:local="clr-namespace:BedwarsOverlay.App"
         xmlns:services="clr-namespace:BedwarsOverlay.App.Services"
        mc:Ignorable="d"
        Title="Bedwars Overlay" Height="450" Width="800"
        Icon="Assets/bedwars-overlay-icon.ico"
        MinWidth="400" MinHeight="200"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" 
                      CornerRadius="0" 
                      CaptionHeight="0" 
                      ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Minimize Button Style -->
        <Style x:Key="MinimizeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Mini ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <!-- Smooth fade in/out based on mouse over the DataGrid -->
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <!-- Vertical ScrollBar -->
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="MinWidth" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="false">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="false">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb x:Name="Thumb" Width="4" Background="#33FFFFFF" BorderThickness="0" HorizontalAlignment="Center">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border CornerRadius="2" Background="{TemplateBinding Background}"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter TargetName="Thumb" Property="Background" Value="#66FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>

                <!-- Horizontal ScrollBar -->
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                                    <Track x:Name="PART_Track" IsDirectionReversed="false" IsEnabled="{TemplateBinding IsEnabled}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="false">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="false">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb x:Name="Thumb" Height="4" Background="#33FFFFFF" BorderThickness="0" VerticalAlignment="Center">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border CornerRadius="2" Background="{TemplateBinding Background}"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="true">
                                        <Setter TargetName="Thumb" Property="Background" Value="#66FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Premium ToolTip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#18181A"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#6366F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid x:Name="MainGrid" PreviewMouseDown="MainGrid_PreviewMouseDown" Focusable="True">
        <Border x:Name="OverlayBorder" CornerRadius="8" BorderThickness="1.5" BorderBrush="#1F2937" Background="#0F0F11">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <!-- Draggable Title Bar (styled like Cubelify) -->
                <Grid x:Name="TitleBar" Background="Transparent" MouseDown="TitleBar_MouseDown" ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Shortcuts_Help, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left: Gold Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="TitleText" Text="Bedwars Overlay" Foreground="#EAB308" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                        <Border x:Name="EditModeBadge" Background="#273636F1" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="EditModeBadgeText" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=EditMode_Badge, Mode=OneWay}" Foreground="#C7D2FE" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Center: Action Icons & Search Box -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                        <TextBlock x:Name="RefreshIcon" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="#FF94A3B8" FontSize="14" Margin="0,0,18,0" Cursor="Hand" ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Tooltip_ClearPlayers, Mode=OneWay}" VerticalAlignment="Center" MouseDown="RefreshButton_Click"/>
                        <TextBlock x:Name="SettingsIcon" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#FF94A3B8" FontSize="14" Margin="0,0,20,0" Cursor="Hand" ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Tooltip_Settings, Mode=OneWay}" VerticalAlignment="Center" MouseDown="SettingsButton_Click"/>
                        
                        <!-- Search Box -->
                        <Border x:Name="SearchPanel" CornerRadius="6" Background="#18181A" BorderThickness="1.2" BorderBrush="#2D2D30" Height="28" Width="200" Padding="6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="&#xE93E;" FontFamily="Segoe MDL2 Assets" Foreground="#66FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                
                                <Grid Grid.Column="1">
                                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Search_Placeholder, Mode=OneWay}" Foreground="#66FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="3,0,0,0" 
                                               x:Name="SearchPlaceholder" IsHitTestVisible="False"/>
                                    <TextBox Background="Transparent" BorderThickness="0" Foreground="White" FontSize="11" VerticalAlignment="Center"
                                             CaretBrush="White"
                                             x:Name="SearchBox" GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" TextChanged="SearchBox_TextChanged"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                    
                    <!-- Right: Exit Window Button -->
                    <StackPanel Grid.Column="2" x:Name="ControlButtons" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Style="{StaticResource MinimizeButtonStyle}" Click="MinimizeButton_Click"/>
                        <Button Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Separator line under Header -->
                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1.2" Background="#1A1A1C"/>

                <!-- Main Area: DataGrid Table -->
                <Grid Grid.Row="1">
                    <!-- Placeholder Text (Shown when no logs/players) -->
                    <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="20">
                        <TextBlock x:Name="DemoText" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Placeholder_Active, Mode=OneWay}" Foreground="White" FontSize="18" FontWeight="Bold" TextAlignment="Center" FontFamily="Segoe UI"/>
                        <TextBlock x:Name="ParsedPlayersText" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Placeholder_Waiting, Mode=OneWay}" Foreground="#FFCCCCCC" FontSize="13" Margin="0,8,0,0" TextAlignment="Center" FontFamily="Segoe UI" TextWrapping="Wrap" MaxWidth="600"/>
                    </StackPanel>

                    <Border x:Name="OnboardingPanel" Panel.ZIndex="20" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Background="#F0111113" BorderBrush="#EAB308" BorderThickness="1.5" CornerRadius="12" Padding="22" Margin="16" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#EAB308" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock x:Name="OnboardingTitleText" Foreground="White" FontSize="19" FontWeight="Bold" TextAlignment="Center" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="OnboardingBodyText" Foreground="#D4D4D8" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,16" FontFamily="Segoe UI"/>
                            <Border Background="#18181A" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock x:Name="OnboardingEditShortcutText" Foreground="#E5E7EB" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="OnboardingHideShortcutText" Foreground="#E5E7EB" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6,0,0" FontFamily="Segoe UI"/>
                                    <TextBlock x:Name="OnboardingSettingsText" Foreground="#A1A1AA" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="OnboardingDoneButton" Height="34" MinWidth="110" HorizontalAlignment="Center" Padding="18,0" Background="#EAB308" Foreground="#111827" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="OnboardingDoneButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Player Stats Grid -->
                    <DataGrid x:Name="PlayersGrid"
                               Background="Transparent"
                               BorderThickness="0"
                               AutoGenerateColumns="False"
                               CanUserAddRows="False"
                               CanUserDeleteRows="False"
                               CanUserReorderColumns="False"
                               CanUserResizeColumns="False"
                               CanUserSortColumns="True"
                               Sorting="PlayersGrid_Sorting"
                               GridLinesVisibility="Horizontal"
                               HorizontalGridLinesBrush="#10FFFFFF"
                               VerticalGridLinesBrush="Transparent"
                               RowHeaderWidth="0"
                               SelectionMode="Single"
                               SelectionUnit="FullRow"
                               IsReadOnly="True"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                               ScrollViewer.VerticalScrollBarVisibility="Auto">
                        
                        <DataGrid.Resources>
                            <!-- Header Style -->
                            <Style x:Key="DefaultHeaderStyle" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FF94A3B8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                            </Style>
                            
                            <!-- Apply default style to all headers in this grid -->
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}"/>
                            
                            <!-- Cell Style -->
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#15FFFFFF"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="RowActionButtonStyle" TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#8B94A6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Width" Value="24"/>
                                <Setter Property="Height" Value="22"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder" CornerRadius="6" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#1AFFFFFF"/>
                                                    <Setter Property="Foreground" Value="#E5E7EB"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2A6366F1"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="RowContextMenuStyle" TargetType="ContextMenu">
                                <Setter Property="Background" Value="#18181A"/>
                                <Setter Property="Foreground" Value="#F4F4F5"/>
                                <Setter Property="BorderBrush" Value="#3F3F46"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="MinWidth" Value="180"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ContextMenu">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7"
                                                    Padding="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="RowMenuItemStyle" TargetType="MenuItem">
                                <Setter Property="Foreground" Value="#F4F4F5"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="10,8" SnapsToDevicePixels="True">
                                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#263636F1"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Foreground" Value="#71717A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding RowBackground}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#10FFFFFF"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsEliminated}" Value="True">
                                        <Setter Property="Background" Value="#AA7F1D1D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        
                        <DataGrid.Columns>
                            <!-- Level Column -->
                            <DataGridTextColumn x:Name="LevelColumn" Header="Lvl" Binding="{Binding Level}" Width="45" IsReadOnly="True" SortMemberPath="LevelRaw">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="ToolTipService.IsEnabled" Value="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"/>
                                        <Setter Property="ToolTip" Value="BedWars Level (Stars &amp; Prestige)"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{Binding LevelColor}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Name Column -->
                            <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="Padding" Value="15,8,10,8"/>
                                        <Setter Property="ToolTipService.IsEnabled" Value="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"/>
                                        <Setter Property="ToolTip" Value="Minecraft Username (Local player marked in blue with badges)"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,0,0,0">
                                            <!-- Blue User Icon for Local Player -->
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="#3B82F6" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" 
                                                       Visibility="{Binding LocalPlayerIconsVisibility}"/>
                                            <!-- Blue Shield Icon for Local Player -->
                                            <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" Foreground="#3B82F6" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" 
                                                       Visibility="{Binding LocalPlayerIconsVisibility}"/>
                                            
                                            <!-- Warning Symbol for High Risk / Blacklist -->
                                            <TextBlock Text="&#x26A0;" Foreground="#FFEF4444" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" 
                                                       Visibility="{Binding TagVisibility}"
                                                       ToolTip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=WarningTooltip, Mode=OneWay}"/>
                                            <Border Background="#55EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="0,0,6,0" Visibility="{Binding EliminationTagVisibility}">
                                                <TextBlock Text="{Binding Tag}" Foreground="#FECACA" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI"/>
                                            </Border>
                                             
                                            <!-- Rank Tag (e.g. [MVP+]) -->
                                            <TextBlock Text="{Binding RankTag}" Foreground="{Binding NameColor}" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center" 
                                                       Visibility="{Binding RankTagVisibility}" FontFamily="Segoe UI" FontSize="11"/>
                                            
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding NameColor}" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Winstreak Column -->
                            <DataGridTextColumn x:Name="WinstreakColumn" Header="WS" Binding="{Binding Winstreak}" Width="45" SortMemberPath="WinstreakRaw">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="ToolTipService.IsEnabled" Value="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"/>
                                        <Setter Property="ToolTip" Value="BedWars Winstreak (WS)"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{Binding WinstreakColor}"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- FKDR Column -->
                            <DataGridTextColumn x:Name="FkdrColumn" Header="FKDR" Binding="{Binding Fkdr}" Width="55" SortMemberPath="FkdrRaw">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="ToolTipService.IsEnabled" Value="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"/>
                                        <Setter Property="ToolTip" Value="Final Kill / Death Ratio (FKDR)"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{Binding FkdrColor}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- WLR Column -->
                            <DataGridTextColumn x:Name="WlrColumn" Header="WLR" Binding="{Binding Wlr}" Width="55" SortMemberPath="WlrRaw">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="ToolTipService.IsEnabled" Value="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"/>
                                        <Setter Property="ToolTip" Value="Win / Loss Ratio (WLR)"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{Binding WlrColor}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Final Kills Column -->
                            <DataGridTextColumn x:Name="FinalKillsColumn" Header="F. Kills" Binding="{Binding FinalKills}" Width="65" SortMemberPath="FinalKillsRaw">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="ToolTipService.IsEnabled" Value="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"/>
                                        <Setter Property="ToolTip" Value="Total BedWars Final Kills"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding FinalsColor}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Wins Column -->
                            <DataGridTextColumn x:Name="WinsColumn" Header="Wins" Binding="{Binding Wins}" Width="65" SortMemberPath="WinsRaw">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="ToolTipService.IsEnabled" Value="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"/>
                                        <Setter Property="ToolTip" Value="Total BedWars Wins"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding WinsColor}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Sniper Column -->
                            <DataGridTextColumn x:Name="SniperColumn" Header="Sniper" Binding="{Binding Sniper}" Width="65" SortMemberPath="SniperRaw">
                                <DataGridTextColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="ToolTipService.IsEnabled" Value="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"/>
                                        <Setter Property="ToolTip" Value="Tehdit Skoru / Sniper Olasılığı (Threat Score / Sniper Chance)"/>
                                    </Style>
                                </DataGridTextColumn.HeaderStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{Binding SniperColor}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Action Column (...) -->
                            <DataGridTemplateColumn Width="30">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultHeaderStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowActionButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="EllipsisButton_Click">
                                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <Button.ContextMenu>
                                                <ContextMenu Style="{StaticResource RowContextMenuStyle}">
                                                    <MenuItem x:Name="ContextCopyUsername" Style="{StaticResource RowMenuItemStyle}" Click="CopyUsername_Click">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Foreground="#A5B4FC" FontSize="12" Width="18" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=ContextMenu_CopyUsername, Mode=OneWay}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem x:Name="ContextOpenPlancke" Style="{StaticResource RowMenuItemStyle}" Click="OpenPlancke_Click">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Foreground="#A5B4FC" FontSize="12" Width="18" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=ContextMenu_OpenPlancke, Mode=OneWay}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Diagnostics Panel (Visible in Edit Mode only) -->
                <Border x:Name="DiagnosticsPanel" Grid.Row="2" Margin="10" Padding="10" Background="#121214" CornerRadius="6" BorderThickness="1.2" BorderBrush="#1F2937" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="DiagnosticsTitle" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=Diagnostics_Title, Mode=OneWay}" Foreground="#FF818CF8" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" FontFamily="Segoe UI"/>
                        <ListBox x:Name="LogDiagnosticsList" Grid.Row="1" Height="80" Background="Transparent" BorderThickness="0" Foreground="#FFAAAAAA" FontSize="10" FontFamily="Consolas, Courier New"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
