<Window x:Class="BedwarsOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BedwarsOverlay.App"
        mc:Ignorable="d"
        Title="Bedwars Overlay" Height="400" Width="800"
        MinWidth="350" MinHeight="150"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" 
                      CornerRadius="0" 
                      CaptionHeight="0" 
                      ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>
    
    <Grid x:Name="MainGrid">
        <Border x:Name="OverlayBorder" CornerRadius="10" BorderThickness="2" BorderBrush="#33FFFFFF" Background="#33000000">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <!-- Draggable Title Bar (active in Edit Mode) -->
                <Grid x:Name="TitleBar" Background="#22000000" MouseDown="TitleBar_MouseDown" Height="35">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- TextBlock with character ellipsis for narrow window widths -->
                    <TextBlock x:Name="StatusText" Text="PLAY MODE • Ctrl+Alt+O to Edit" 
                               Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="10,0,10,0" 
                               FontWeight="Bold" FontFamily="Segoe UI, Arial" FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                    
                    <StackPanel x:Name="ControlButtons" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Content="Settings" Click="SettingsButton_Click" Margin="5" Padding="12,0" Background="#33FFFFFF" Foreground="White" BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI"/>
                        <Button Content="X" Click="CloseButton_Click" Width="30" Margin="5" Background="#88FF5555" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Grid>
                
                <!-- Overlay Contents -->
                <Grid Grid.Row="1" Margin="15">
                    <!-- Viewbox scales down core messages if window is small -->
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="100">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="DemoText" Text="Bedwars Overlay Active" Foreground="White" FontSize="20" FontWeight="Bold" TextAlignment="Center" FontFamily="Segoe UI"/>
                            <TextBlock Text="Waiting for Minecraft logs... Type /who in-game." Foreground="#FFCCCCCC" FontSize="14" Margin="0,5,0,0" TextAlignment="Center" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Viewbox>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
