<Window x:Class="BedwarsOverlay.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings" Height="400" Width="480"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Form Label Style -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF94A3B8"/> <!-- Slate 400 -->
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Standard TextInput Border Style -->
        <Style x:Key="TextBoxBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#18181A"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="BorderBrush" Value="#2D2D30"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <!-- Custom TextBox Style -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="FormPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/> <!-- Indigo 500 -->
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4F46E5"/> <!-- Indigo 600 -->
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/> <!-- Zinc 800 -->
            <Setter Property="Foreground" Value="#FFD4D4D8"/> <!-- Zinc 300 -->
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Inline Browse Button Style -->
        <Style x:Key="InlineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Styled Outer Border -->
        <Border BorderBrush="#6366F1" BorderThickness="1.5" CornerRadius="8" Background="#0F0F11">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="56" />
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <Grid x:Name="TitleBar" Background="Transparent" MouseDown="TitleBar_MouseDown">
                    <TextBlock Text="Overlay Settings" Foreground="#EAB308" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="10" 
                            Background="Transparent" BorderThickness="0" Width="40" Height="40" HorizontalAlignment="Right"
                            Click="CancelButton_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Settings Content Area -->
                <StackPanel Grid.Row="1" Margin="20,10,20,10">
                    
                    <!-- Hypixel API Key -->
                    <TextBlock Text="Hypixel API Key" Style="{StaticResource FormLabelStyle}"/>
                    <Border Style="{StaticResource TextBoxBorderStyle}" Margin="0,0,0,16">
                        <Grid>
                            <PasswordBox x:Name="ApiKeyMaskedBox" Style="{StaticResource FormPasswordBoxStyle}" PasswordChar="*" GotFocus="ApiKeyMaskedBox_GotFocus"/>
                            <TextBox x:Name="ApiKeyBox" Style="{StaticResource FormTextBoxStyle}" Text="" IsUndoEnabled="True" Visibility="Collapsed" LostFocus="ApiKeyBox_LostFocus"/>
                        </Grid>
                    </Border>

                    <!-- Log File Path -->
                    <TextBlock Text="Minecraft Client Log Path (latest.log)" Style="{StaticResource FormLabelStyle}"/>
                    <Border Style="{StaticResource TextBoxBorderStyle}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="LogPathBox" Style="{StaticResource FormTextBoxStyle}" Text="" IsReadOnly="True" ToolTip="{Binding Text, ElementName=LogPathBox}"/>
                            <Button Grid.Column="1" Content="Auto-Detect" Style="{StaticResource InlineButtonStyle}" Click="AutoDetectButton_Click" Margin="6,0,0,0"/>
                            <Button Grid.Column="2" Content="Browse..." Style="{StaticResource InlineButtonStyle}" Click="BrowseButton_Click" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Local Player Name -->
                    <TextBlock Text="Local Player Username (Optional, highlights yourself in blue)" Style="{StaticResource FormLabelStyle}"/>
                    <Border Style="{StaticResource TextBoxBorderStyle}" Margin="0,0,0,16">
                        <TextBox x:Name="LocalPlayerBox" Style="{StaticResource FormTextBoxStyle}" Text=""/>
                    </Border>

                    <CheckBox x:Name="ShowLogDiagnosticsBox" Content="Show Log Diagnostics in edit mode" Foreground="#FFD4D4D8" FontSize="12" FontFamily="Segoe UI"/>
                    
                </StackPanel>

                <!-- Footer Action Buttons -->
                <Border Grid.Row="2" Background="#18181A" CornerRadius="0,0,8,8" BorderThickness="0,1,0,0" BorderBrush="#27272A">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click" Width="80" Margin="0,0,10,0"/>
                        <Button Content="Save Settings" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" Width="110"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
